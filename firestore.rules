rules_version = '2';

// ===============================================================
// LEVIX E-Commerce Platform - Production Security Rules
// ===============================================================
// Authoritative Database: Hostinger MySQL (u214946046_levix)
// Section 4.4 - LEVIX Production Readiness Plan
//
// In accordance with Section 4.4 of the LEVIX Production Readiness
// Plan, Hostinger MySQL serves as the single source of truth for
// all store data (products, categories, store settings, orders).
// Direct client read and write operations to Cloud Firestore are
// completely disabled to prevent data drift, bypass of MySQL business
// logic, or unauthorized access.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    // Deny all reads and writes across all collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
