<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Preserve HTTP Authorization Header for PHP FastCGI/FPM on Hostinger
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Security Rules: Block data files, dotfiles, and sensitive extensions (Appendix C)
  RewriteRule ^api/data/ - [F,L]
  RewriteRule (^|/)\. - [F,L]
  RewriteRule \.(env|sql|log|bak|json\.bak)$ - [F,L]

  # Don't rewrite real files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback all other routes to index.html for SPA client-side routing
  RewriteRule ^ index.html [L]
</IfModule>

# Preserve Authorization header when mod_setenvif is enabled
<IfModule mod_setenvif.c>
  SetEnvIfNoCase Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# Block sensitive and hidden files
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<FilesMatch "\.(env|sql|log|bak|ini|lock|md)$">
  Require all denied
</FilesMatch>

# Correct MIME Types
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddType application/javascript .js
</IfModule>

# Security Headers (Appendix C & Section 3)
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://checkout.razorpay.com https://www.googletagmanager.com; frame-src https://api.razorpay.com https://checkout.razorpay.com; connect-src 'self' https://*.googleapis.com https://identitytoolkit.googleapis.com https://api.razorpay.com https://thelevix.shop http://localhost:5000 http://localhost:5173"
</IfModule>

# Strict Anti-Caching for Dynamic Entry & Service Worker Files
<FilesMatch "(sw\.js|registerSW\.js|index\.html|manifest\.webmanifest)$">
  <IfModule mod_expires.c>
    ExpiresActive Off
  </IfModule>
  <IfModule mod_headers.c>
    Header unset ETag
    Header unset Expires
    Header always set Cache-Control "no-cache, no-store, must-revalidate, proxy-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </IfModule>
</FilesMatch>

# Never cache dynamic PHP API endpoints
<FilesMatch "^(index\.php)$">
  <IfModule mod_expires.c>
    ExpiresActive Off
  </IfModule>
  <IfModule mod_headers.c>
    Header unset ETag
    Header unset Expires
    Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </IfModule>
</FilesMatch>

# Safe long-term caching for hashed build assets
<IfModule mod_headers.c>
  <FilesMatch "\.(css|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Caching Headers
<IfModule mod_expires.c>
  ExpiresActive On

  # Dynamic Entry: Instant revalidation
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 0 seconds"

  # Static assets
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Prevent direct directory browsing
Options -Indexes
