<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Ensure HTTPS
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Don't rewrite real files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback all other routes to index.html for SPA client-side routing
  RewriteRule ^ index.html [L]
</IfModule>

# Correct MIME Types
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddType application/javascript .js
</IfModule>

# Strict Anti-Caching for Dynamic Entry & Service Worker Files
<IfModule mod_headers.c>
  # 1. CRITICAL: Never cache Service Worker, register script, manifest, or HTML shell
  <FilesMatch "(sw\.js|registerSW\.js|index\.html|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, proxy-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # 2. Never cache dynamic PHP API endpoints
  <FilesMatch "^(index\.php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # 3. Safe long-term caching for hashed build assets
  <FilesMatch "\.(css|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Caching Headers
<IfModule mod_expires.c>
  ExpiresActive On

  # Dynamic Entry: Instant revalidation
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 0 seconds"

  # Static assets
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Prevent direct directory browsing
Options -Indexes
