# ==============================================================================
# LEVIX — PRODUCTION-READY ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT ENVIRONMENT (Vite Public Variables - Bundled into Browser JS)
# ------------------------------------------------------------------------------
# Firebase Web App Credentials (from Firebase Console -> Project Settings -> General)
VITE_FIREBASE_API_KEY=AIzaSy...YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=levix-store.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=levix-store
VITE_FIREBASE_STORAGE_BUCKET=levix-store.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Razorpay Client-Side Key ID (Test key starts with rzp_test_, Live with rzp_live_)
VITE_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID

# Optional custom backend URL (Leave blank to use relative /api proxy in development)
VITE_API_URL=

# ------------------------------------------------------------------------------
# 2. TRUSTED BACKEND ENVIRONMENT (Private Server-Only - NEVER expose to browser)
# ------------------------------------------------------------------------------
PORT=5000

# Razorpay Secret Credentials (from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SIGNING_SECRET

# Admin token secret for backend administrative operations
ADMIN_SECRET_KEY=YOUR_SECURE_ADMIN_SECRET_TOKEN
