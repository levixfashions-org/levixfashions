# ==============================================================================
# LEVIX Streetwear - Environment Configuration Template
# Copy this file to .env.local for local development, or to .env on your server.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# In local dev: http://localhost:3000 | In production: https://thelevix.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. DATABASE (MySQL via Prisma)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?connection_limit=10&pool_timeout=20
# For Hostinger MySQL: Replace user, password, host, and database name.
# ------------------------------------------------------------------------------
DATABASE_URL="mysql://root:password@localhost:3306/levix_db?connection_limit=10&pool_timeout=20"

# ------------------------------------------------------------------------------
# 3. RAZORPAY PAYMENT GATEWAY
# Get these from: https://dashboard.razorpay.com/app/keys
# Start with Test Mode (rzp_test_...) then switch to Live Mode (rzp_live_...)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID_HERE"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_SECRET_KEY_HERE"
# Webhook secret from: Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET="YOUR_WEBHOOK_SECRET_KEY_HERE"

# ------------------------------------------------------------------------------
# 4. FIREBASE AUTHENTICATION (Client SDK)
# Get these from: Firebase Console -> Project Settings -> General -> Your Apps (Web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYOUR_API_KEY_HERE"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="thelevix-streetwear.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="thelevix-streetwear"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="thelevix-streetwear.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# ------------------------------------------------------------------------------
# 5. FIREBASE ADMIN SDK (Server-Side Verification)
# Get from: Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
# IMPORTANT: Keep private key enclosed in quotes with newlines as \n
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="thelevix-streetwear"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@thelevix-streetwear.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 6. SESSION SECURITY
# Any random 32+ character string used to encrypt session tokens
# ------------------------------------------------------------------------------
SESSION_SECRET="levix_streetwear_super_secret_session_key_32chars_long"

# ------------------------------------------------------------------------------
# 7. TRANSACTIONAL EMAILS (Hostinger Titan Mail / SMTP / Resend)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.titan.email"
SMTP_PORT=465
SMTP_USER="orders@thelevix.com"
SMTP_PASS="YOUR_EMAIL_PASSWORD_HERE"
SMTP_FROM="LEVIX <orders@thelevix.com>"
